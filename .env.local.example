# Google Gemini API Key
# Google AI Studio(https://aistudio.google.com/)에서 API 키를 발급받아 입력하세요.
GEMINI_API_KEY=your_gemini_api_key_here

# (선택 사항) Gemini 모델명 (기본값: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# (선택 사항) CloudConvert API 키 — LibreOffice가 없는 환경(예: Vercel)에서
# PPTX/DOCX → PDF 미리보기 변환에 사용됩니다. https://cloudconvert.com/dashboard/api/v2/keys
# CLOUDCONVERT_API_KEY=your_cloudconvert_api_key_here
